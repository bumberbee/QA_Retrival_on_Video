# Copy to .env and fill in. Never commit .env.

# ---- LLM ----
LLM_PROVIDER=ollama                  # ollama (Vast GPU / local) or gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=1800
OLLAMA_NUM_CTX=8192
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Answer repairs (all off by default: the evaluated baseline stays unchanged) ----
ASK_STRIP_REFUSAL=                   # on: drop a leading refusal when an answer follows and evidence matches
ASK_ATTRIBUTE=                       # on: add [mm:ss] of the closest evidence to sentences the model left uncited
ASK_ATTRIBUTE_MIN=0.84               # E5 cosine needed to attribute a sentence; not calibrated yet
ASK_CITE_REMINDER=                   # on: repeat the citation rule after the question

# ---- Local file storage (used when SUPABASE_DB_URL is empty) ----
LECTURE_RAG_DATA_DIR=

# ---- Supabase (Project Settings -> Database -> Connection string, "Session pooler") ----
SUPABASE_DB_URL=                     # postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=                        # https://<ref>.supabase.co  (frontend reads app_config with the anon key)
SUPABASE_ANON_KEY=
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_SIZE=5

# ---- Cloudflare R2 (R2 -> Manage API tokens, Object Read & Write) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lecture-rag

# ---- Web ----
CORS_ORIGINS=                        # explicit frontend origins, comma separated; * is ignored
# Writes require X-Admin-Token when set. Empty: allowed locally, disabled in cloud mode.
# Cloud uploads, URL imports and transcript replacement remain unsupported even with a token.
ADMIN_TOKEN=                         # set a strong secret on the demo backend; never expose in frontend env
MAX_UPLOAD_MB=2048                   # MiB per uploaded file; multipart envelope is also bounded

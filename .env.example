# Copy to .env and fill in. Never commit .env.

# ---- LLM ----
LLM_PROVIDER=ollama                  # ollama (Vast GPU / local) or gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=1800
OLLAMA_NUM_CTX=8192
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Local file storage (used when SUPABASE_DB_URL is empty) ----
LECTURE_RAG_DATA_DIR=

# ---- Supabase (Project Settings -> Database -> Connection string, "Session pooler") ----
SUPABASE_DB_URL=                     # postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=                        # https://<ref>.supabase.co  (frontend reads app_config with the anon key)
SUPABASE_ANON_KEY=

# ---- Cloudflare R2 (R2 -> Manage API tokens, Object Read & Write) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lecture-rag

# ---- Web ----
CORS_ORIGINS=                        # e.g. https://lecture-rag.vercel.app (comma separated)

# Vercel -> Project Settings -> Environment Variables (build time)
# Local dev needs none of these (default backend http://localhost:8001/api).
VITE_SUPABASE_URL=            # https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=       # anon public key: only reads app_config.backend_url
VITE_API_BASE_URL=            # optional fixed backend URL (used when app_config has none)
